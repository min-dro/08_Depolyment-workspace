spring.application.name=Test_Project1

# context path, 서버의 포트번호 지정
server.servlet.context-path=/myapp
server.port=8006

# View Resolver
spring.mvc.view.prefix=/WEB-INF/views/
spring.mvc.view.suffix=.jsp

# 빌드 시 내장 서버를 죽이는 설정 (내장 서버 비활성화)
spring.main.web-application-type=none

# war 형식으로 빌드를 하면 위에서 설정했던 context path 와 포트번호는 무효화 된다!!
